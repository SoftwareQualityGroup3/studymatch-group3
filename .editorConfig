# EditorConfig — StudyMatch
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# Java (backend)
[*.java]
indent_size = 4

# JavaScript / JSX / TypeScript (frontend)
[*.{js,jsx,ts,tsx}]
indent_size = 2

# JSON
[*.json]
indent_size = 2

# YAML
[*.{yml,yaml}]
indent_size = 2

# Markdown — preservar espaços finais (usados para quebra de linha)
[*.md]
trim_trailing_whitespace = false
indent_size = 2

# SQL migrations
[*.sql]
indent_size = 2

# Makefiles exigem tabs
[Makefile]
indent_style = tab
